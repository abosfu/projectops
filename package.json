{
  "name": "projectops-engine",
  "version": "1.0.0",
  "description": "ProjectOps - Construction Schedule & Budget Risk Monitor",
  "type": "module",
  "scripts": {
    "ingest": "tsx apps/cli/ingest.ts",
    "gen:sample": "tsx scripts/generate_sample_run.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "tsc --noEmit",
    "dev:api": "tsx apps/api/apiServer.ts",
    "dev:web": "cd apps/web && vite",
    "build:web": "cd apps/web && vite build",
    "build:api": "tsc --project apps/api/tsconfig.json",
    "build": "npm run build:api && npm run build:web",
    "start": "NODE_ENV=production node apps/api/dist/apiServer.js",
    "preview:web": "cd apps/web && vite preview",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "cleanup:runs": "tsx scripts/cleanup_runs.ts",
    "reset:demo": "tsx scripts/reset_demo.ts",
    "demo:reset": "tsx scripts/reset_demo.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/multer": "^2.0.0",
    "express": "^4.18.2",
    "multer": "^2.0.2",
    "papaparse": "^5.4.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.15.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^1.0.4"
  }
}
